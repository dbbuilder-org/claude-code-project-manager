<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template plist — install with:
    sed "s|__PM_DIR__|$(pwd)|g" scripts/com.pm.daily-brief.plist \
      > ~/Library/LaunchAgents/com.pm.daily-brief.plist
    launchctl load ~/Library/LaunchAgents/com.pm.daily-brief.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pm.daily-brief</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PM_DIR__/scripts/daily-brief.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__PM_DIR__/logs/daily-brief.log</string>

    <key>StandardErrorPath</key>
    <string>__PM_DIR__/logs/daily-brief-error.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
